{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // Notebooks use paths relative to notebooks/ (../data, ../figures), matching `cd notebooks` in the README.
  "jupyter.notebookFileRoot": "${fileDirname}",
  "files.watcherExclude": {
    "**/data/**": true,
    "**/notebooks/cache/**": true
  },
  "search.exclude": {
    "data/**": true,
    "notebooks/cache/**": true,
    "uv.lock": true
  }
}
