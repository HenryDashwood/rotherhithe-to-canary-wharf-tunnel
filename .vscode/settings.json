{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // Notebooks run from their own folder (nbs/), like nbdev
  "jupyter.notebookFileRoot": "${fileDirname}",
  "files.watcherExclude": {
    "**/data/**": true
  },
  "search.exclude": {
    "data/**": true,
    "uv.lock": true
  }
}
